# Wattalis · variables de entorno
# Copia este archivo a .env.local y complétalo. No subas .env.local al repositorio.

# URL del proyecto de Supabase (Project Settings → API).
# Local con Supabase CLI: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública del proyecto: "publishable key" (sb_publishable_…) o, en proyectos
# anteriores, la "anon key". Es pública por diseño: RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública de la aplicación, usada en los enlaces de correo e invitaciones.
# Local: http://localhost:3000 · Producción: https://tu-dominio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# La aplicación NO necesita la service_role key en tiempo de ejecución.
# No la agregues aquí ni en Vercel.

# -----------------------------------------------------------------------------
# Suscripciones (ver docs/SUSCRIPCIONES.md). Nada es necesario para la demostración:
# en `npm run dev` se usa la pasarela SIMULADA (sin cobros reales).
# -----------------------------------------------------------------------------
# Vacío: la demostración aplica a las sesiones del modo de prueba («Pruebas»).
# mock: también a cuentas reales de Supabase (solo desarrollo o WATTALIS_DEMO=1).
# none: desactivar. stripe: futuro, aún no implementado.
# La pasarela simulada nunca se activa en producción sin WATTALIS_DEMO=1.
# WATTALIS_BILLING_PROVIDER=
# Secreto HMAC de la pasarela simulada (opcional).
# WATTALIS_MOCK_WEBHOOK_SECRET=

# --- Futuro (solo servidor; en AWS desde Secrets Manager, nunca con NEXT_PUBLIC_) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# DATABASE_URL=                       # o RDS_SECRET_ARN para el procesador de eventos
# AWS_REGION=
# WATTALIS_SES_FROM=
# WATTALIS_SES_CONFIGURATION_SET=
# WATTALIS_BILLING_QUEUE_URL=
# COGNITO_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_DOMAIN=
# WATTALIS_CFDI_PROVIDER=
# WATTALIS_CFDI_API_KEY=
